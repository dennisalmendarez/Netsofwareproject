<section class="dashboard-panel">
    <h2>@Title</h2>

    @if (Items.Count == 0)
    {
        <p class="no-results">No items in this section yet.</p>
    }
    else
    {
        <div class="dashboard-library-grid">
            @foreach (var item in Items)
            {
                <div class="dashboard-media-card">
                    <img src="@item.ImageUrl" alt="@item.Title poster" />

                    <div class="dashboard-media-body">
                        <h3>@item.Title</h3>
                        <p>@item.Type • @item.Genre</p>

                        @if (!string.IsNullOrWhiteSpace(item.Status))
                        {
                            <p><strong>Status:</strong> @item.Status</p>
                        }

                        @if (item.IsFavorite)
                        {
                            <p>❤️ Favorite</p>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public List<AnimeMovieTracker.Components.Pages.Dashboard.DashboardMediaItem> Items { get; set; } = new();
}