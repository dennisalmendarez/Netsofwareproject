@page "/dashboard"
@rendermode InteractiveServer
@using AnimeMovieTracker.Components.Models

<PageTitle>Dashboard</PageTitle>

<h1>My Dashboard</h1>

<section class="dashboard-hero">
    <div>
        <p class="eyebrow">Your Library</p>
        <h2>Welcome back, Dennis</h2>
        <p>Manage your anime, movies, favorites, watch status, and account settings.</p>
    </div>
</section>

<div class="dashboard-tabs">
    <button class="@(activeSection == "overview" ? "active-tab" : "")" @onclick='() => ChangeSection("overview")'>
        Overview
    </button>

    <button class="@(activeSection == "watching" ? "active-tab" : "")" @onclick='() => ChangeSection("watching")'>
        Watching
    </button>

    <button class="@(activeSection == "want" ? "active-tab" : "")" @onclick='() => ChangeSection("want")'>
        Want to Watch
    </button>

    <button class="@(activeSection == "watched" ? "active-tab" : "")" @onclick='() => ChangeSection("watched")'>
        Watched
    </button>

    <button class="@(activeSection == "dropped" ? "active-tab" : "")" @onclick='() => ChangeSection("dropped")'>
        Dropped
    </button>

    <button class="@(activeSection == "favorites" ? "active-tab" : "")" @onclick='() => ChangeSection("favorites")'>
        Favorites
    </button>

    <button class="@(activeSection == "account" ? "active-tab" : "")" @onclick='() => ChangeSection("account")'>
        Account
    </button>
</div>

@if (activeSection == "overview")
{
    <section class="dashboard-grid">
        <div class="dashboard-card">
            <h2>@WatchingItems.Count</h2>
            <p>Watching</p>
        </div>

        <div class="dashboard-card">
            <h2>@WantToWatchItems.Count</h2>
            <p>Want to Watch</p>
        </div>

        <div class="dashboard-card">
            <h2>@WatchedItems.Count</h2>
            <p>Watched</p>
        </div>

        <div class="dashboard-card">
            <h2>@DroppedItems.Count</h2>
            <p>Dropped</p>
        </div>

        <div class="dashboard-card">
            <h2>@FavoriteItems.Count</h2>
            <p>Favorites</p>
        </div>

        <div class="dashboard-card">
            <h2>@AllItems.Count</h2>
            <p>Total Saved</p>
        </div>
    </section>

    <section class="dashboard-panel">
        <h2>Recent Activity</h2>

        @if (AllItems.Count == 0)
        {
            <p class="no-results">No saved activity yet. Start tracking anime and movies to fill your dashboard.</p>
        }
        else
        {
            <div class="dashboard-list">
                @foreach (var item in AllItems.Take(5))
                {
                    <div class="dashboard-list-item">
                        <img src="@item.ImageUrl" alt="@item.Title poster" />
                        <div>
                            <h3>@item.Title</h3>
                            <p>@item.Type • @(string.IsNullOrWhiteSpace(item.Status) ? "No Status" : item.Status)</p>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}
else if (activeSection == "watching")
{
    <DashboardSection Title="Watching" Items="WatchingItems" />
}
else if (activeSection == "want")
{
    <DashboardSection Title="Want to Watch" Items="WantToWatchItems" />
}
else if (activeSection == "watched")
{
    <DashboardSection Title="Watched" Items="WatchedItems" />
}
else if (activeSection == "dropped")
{
    <DashboardSection Title="Dropped" Items="DroppedItems" />
}
else if (activeSection == "favorites")
{
    <DashboardSection Title="Favorites" Items="FavoriteItems" />
}
else if (activeSection == "account")
{
    <section class="dashboard-panel">
        <h2>Account Settings</h2>

        <div class="account-grid">
            <div class="account-card">
                <h3>Profile</h3>
                <label>Display Name</label>
                <input value="Dennis" />

                <label>Email</label>
                <input value="dennis@example.com" />

                <button class="filter-button">Save Profile</button>
            </div>

            <div class="account-card">
                <h3>Preferences</h3>

                <label>Default Media Type</label>
                <select>
                    <option>Anime and Movies</option>
                    <option>Anime Only</option>
                    <option>Movies Only</option>
                </select>

                <label>Favorite Genre</label>
                <select>
                    <option>Action</option>
                    <option>Adventure</option>
                    <option>Comedy</option>
                    <option>Drama</option>
                    <option>Sci-Fi</option>
                </select>

                <button class="filter-button">Save Preferences</button>
            </div>

            <div class="account-card danger-zone">
                <h3>Account Actions</h3>
                <p>This area will connect to real authentication later.</p>

                <button class="random-button">Log Out</button>
                <button class="danger-button">Delete Account</button>
            </div>
        </div>
    </section>
}

@code {
    private string activeSection = "overview";

    // Temporary front-end demo data.
    // Later this will come from the database for the logged-in user.
    private List<DashboardMediaItem> AllItems = new()
    {
        new DashboardMediaItem
        {
            Id = 101922,
            Title = "Demon Slayer",
            Type = "Anime",
            Genre = "Action",
            Status = "Watching",
            IsFavorite = true,
            ImageUrl = "https://placehold.co/300x450?text=Demon+Slayer"
        },
        new DashboardMediaItem
        {
            Id = 151807,
            Title = "Solo Leveling",
            Type = "Anime",
            Genre = "Fantasy",
            Status = "Want to Watch",
            IsFavorite = true,
            ImageUrl = "https://placehold.co/300x450?text=Solo+Leveling"
        },
        new DashboardMediaItem
        {
            Id = 157336,
            Title = "Interstellar",
            Type = "Movie",
            Genre = "Sci-Fi",
            Status = "Watched",
            IsFavorite = false,
            ImageUrl = "https://placehold.co/300x450?text=Interstellar"
        },
        new DashboardMediaItem
        {
            Id = 155,
            Title = "The Dark Knight",
            Type = "Movie",
            Genre = "Action",
            Status = "Dropped",
            IsFavorite = false,
            ImageUrl = "https://placehold.co/300x450?text=Dark+Knight"
        }
    };

    private List<DashboardMediaItem> WatchingItems =>
        AllItems.Where(x => x.Status == "Watching").ToList();

    private List<DashboardMediaItem> WantToWatchItems =>
        AllItems.Where(x => x.Status == "Want to Watch").ToList();

    private List<DashboardMediaItem> WatchedItems =>
        AllItems.Where(x => x.Status == "Watched").ToList();

    private List<DashboardMediaItem> DroppedItems =>
        AllItems.Where(x => x.Status == "Dropped").ToList();

    private List<DashboardMediaItem> FavoriteItems =>
        AllItems.Where(x => x.IsFavorite).ToList();

    private void ChangeSection(string section)
    {
        activeSection = section;
    }

    public class DashboardMediaItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Type { get; set; } = "";
        public string Genre { get; set; } = "";
        public string Status { get; set; } = "";
        public bool IsFavorite { get; set; }
        public string ImageUrl { get; set; } = "";
    }
}