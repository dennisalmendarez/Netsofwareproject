@page "/dashboard"
@rendermode InteractiveServer
@using AnimeMovieTracker.Components.Models
@using AnimeMovieTracker.Components.Shared

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<div class="dashboard-grid">
    <div class="dashboard-card">
        <h2>@SampleData.Items.Count</h2>
        <p>Total Titles</p>
    </div>

    <div class="dashboard-card">
        <h2>@SampleData.Items.Count(x => x.Type == "Anime")</h2>
        <p>Anime</p>
    </div>

    <div class="dashboard-card">
        <h2>@SampleData.Items.Count(x => x.Type == "Movie")</h2>
        <p>Movies</p>
    </div>
</div>

<h2>My Watchlist</h2>

<div class="media-grid">
    @foreach (var item in SampleData.Items)
    {
        <MediaCard Item="item" />
    }
</div>